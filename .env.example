NEXT_PUBLIC_SITE_URL=https://ksprotect.is
SHOP_ADMIN_PASSWORD=ksprotect2026
# Create a Blob store in Vercel Storage and connect it to this project.
# Vercel will inject BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=

# Email (Resend) — forms + password-change codes go to MAIL_TO
RESEND_API_KEY=
MAIL_TO=ksprotect@ksprotect.is
# After verifying domain in Resend, set e.g. "KS Protect <noreply@ksprotect.is>"
MAIL_FROM=KS Protect <onboarding@resend.dev>

# Cloudflare Turnstile captcha (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Valitor card checkout (merchant credentials from Valitor/Rapyd).
# Without these, "Pay by card" still works via order email + payment link.
VALITOR_MERCHANT_ID=
VALITOR_VERIFICATION_CODE=
VALITOR_PAYMENT_URL=https://payment.valitor.is/PayPage/
